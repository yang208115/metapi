{
  "name": "metapi",
  "version": "1.3.0",
  "description": "Refactored self-hosted gateway for AI API aggregation, routing, and observability",
  "keywords": [
    "ai",
    "api-gateway",
    "proxy",
    "fastify",
    "openai",
    "claude",
    "aggregator"
  ],
  "homepage": "https://github.com/yang208115/metapi#readme",
  "bugs": {
    "url": "https://github.com/yang208115/metapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yang208115/metapi.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev:server": "tsx scripts/dev/run-server.ts --watch",
    "dev": "concurrently \"npm run dev:server\" \"vite\"",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json && tsx scripts/dev/copy-runtime-db-generated.ts",
    "build": "npm run build:web && npm run build:server",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "test": "node --import tsx --test scripts/tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch scripts/tests/*.test.ts",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "schema:contract": "tsx scripts/dev/generate-schema-contract.ts",
    "schema:generate": "npm run db:generate && npm run schema:contract",
    "repo:drift-check": "tsx scripts/dev/repo-drift-check.ts",
    "readme:contributors": "tsx scripts/dev/update-readme-contributors.ts",
    "smoke:db": "tsx scripts/dev/db-smoke.ts",
    "smoke:db:sqlite": "tsx scripts/dev/db-smoke.ts --db-type sqlite",
    "smoke:db:mysql": "tsx scripts/dev/db-smoke.ts --db-type mysql",
    "smoke:db:postgres": "tsx scripts/dev/db-smoke.ts --db-type postgres"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@visactor/react-vchart": "^2.0.22",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.4",
    "get-port": "^7.2.0",
    "marked": "^18.0.3",
    "minimatch": "^10.2.5",
    "minimist": "^1.2.8",
    "mysql2": "^3.22.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^11.1.0",
    "socks": "^2.8.9",
    "undici": "^6.25.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^6.4.2"
  },
  "overrides": {
    "minimist": "^1.2.8"
  },
  "author": {
    "name": "cita-777",
    "email": "cita-777@users.noreply.github.com",
    "url": "https://github.com/cita-777"
  }
}
